# ============================================================================
# WaaP Configuration (Human.tech - Wallet as a Protocol)
# ============================================================================
# WaaP does NOT require an App ID - just install @human.tech/waap-sdk
# WaaP provides EOA creation with Two-Party Computation (2PC) security
# See: https://docs.wallet.human.tech/quick-start
#
# Installation: npm install @human.tech/waap-sdk
# 
# Optional: WalletConnect Project ID (only if using 'wallet' auth method)
# Get one at: https://cloud.walletconnect.com
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id

# ============================================================================
# ZeroDev Configuration (for smart wallet creation)
# ============================================================================
# Create a project in ZeroDev dashboard (Alfajores) and use that Project ID
# The same Project ID will work with Celo Mainnet in the code
NEXT_PUBLIC_ZERODEV_PROJECT_ID=your_zerodev_project_id_here

# ZeroDev Paymaster Mode (optional)
# Set to 'true' if using self-funded paymaster (requires CELO deposit to paymaster contract on Celo Mainnet)
# Set to 'false' or leave unset to use credit card billing (recommended, simpler)
# 
# IMPORTANT for Self-Funded Mode:
# - Your ZeroDev project is created on Alfajores (testnet) in the dashboard (free plan)
# - But you must deposit CELO to the paymaster contract on Celo Mainnet (chain 42220)
# - The paymaster contract address can be found in ZeroDev documentation
# - Verify the deposit on CeloScan: https://explorer.celo.org
NEXT_PUBLIC_ZERODEV_SELF_FUNDED=true

# ============================================================================
# Pimlico Paymaster Configuration (for gasless transactions)
# ============================================================================
# Get your API key from https://dashboard.pimlico.io
# This enables gasless transactions for smart wallets
# IMPORTANT: This is a SERVER-SIDE variable (no NEXT_PUBLIC_ prefix)
# The API key is kept secure on the server via /api/pimlico/paymaster proxy
PIMLICO_API_KEY=your_pimlico_api_key_here

# Paymaster Selection (optional)
# Set to 'true' to force using ZeroDev paymaster instead of Pimlico
# If not set or 'false', the code will try Pimlico first, then fallback to ZeroDev
# NEXT_PUBLIC_USE_ZERODEV_PAYMASTER=true

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL="postgresql://username:password@localhost:5432/motusdao_hub"

# ============================================================================
# Supabase Configuration
# ============================================================================
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key (for server-side operations like file uploads)
# WARNING: Never expose this in client-side code!
SUPABASE_KEY=your_supabase_service_role_key
# Prefer explicit name when used for Motus Knowledge RAG (same as Hub-Psi)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================================================
# MotusDAO Knowledge RAG (Hub-Psi / MCP-MotusDAO corpus)
# ============================================================================
# ChatAlpha may use a different Supabase project for app auth/DB.
# Point these at the knowledge corpus project (same as MCP-MotusDAO ingest).
# MOTUS_KNOWLEDGE_SUPABASE_URL=https://YOUR_KNOWLEDGE_PROJECT.supabase.co
# MOTUS_KNOWLEDGE_SUPABASE_SERVICE_ROLE_KEY=your_knowledge_service_role_key
AI_PROVIDER=venice
VENICE_INFERENCE_KEY=your_venice_inference_key
VENICE_API_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL=zai-org-glm-5
# Must match MCP-MotusDAO ingest (default Venice: text-embedding-bge-m3)
EMBEDDING_MODEL=text-embedding-bge-m3
EMBEDDING_PROVIDER=venice

# ============================================================================
# MotusAI inference / auth / ops (Wave 3)
# ============================================================================
# json_object | json_schema | off
# Default off: zai-org-glm-5 returns empty content with json_object.
MOTUSAI_JSON_MODE=off
# Set true only if your model streams structured output correctly
# MOTUSAI_JSON_MODE_ON_STREAM=true
# Require WaaP id header on /api/motusai (default: true in production)
# MOTUSAI_REQUIRE_AUTH=true
MOTUSAI_RATE_LIMIT_PER_MIN=20
MOTUSAI_RATE_LIMIT_PER_DAY=200
# MOTUSAI_MAX_HISTORY_MESSAGES=48
# Protect GET /api/motusai/metrics in production
# MOTUSAI_METRICS_KEY=your_random_metrics_key

# ============================================================================
# OpenAI Configuration (optional fallback if AI_PROVIDER=openai)
# ============================================================================
OPENAI_API_KEY=your_openai_api_key

# ============================================================================
# Production Environment
# ============================================================================
NODE_ENV=production

# ============================================================================
# Celo Network Configuration
# ============================================================================
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org
NEXT_PUBLIC_CELO_CHAIN_ID=42220

# Optional: For development/testing
NEXT_PUBLIC_CELO_ALFAJORES_RPC_URL=https://alfajores-forno.celo-testnet.org
NEXT_PUBLIC_CELO_ALFAJORES_CHAIN_ID=44787

# ============================================================================
# DAO Treasury Address (for payment destination selection)
# ============================================================================
NEXT_PUBLIC_DAO_TREASURY_ADDRESS=0xf229F3Dcea3D7cd3cA5ca41C4C50135D7b37F2b9

# ============================================================================
# Jitsi Configuration
# ============================================================================
# Domain of your Jitsi server for production (e.g. videochat.motusdao.org or meet.jit.si for testing)
# IMPORTANT: meet.jit.si has a 5-minute time limit. Use your own self-hosted server for unlimited sessions.
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
# Optional prefix for generated room names (both backend and frontend will use this)
NEXT_PUBLIC_JITSI_ROOM_PREFIX=motusdao-

# Jitsi JWT Authentication (Optional but recommended for production)
# Get these from your Jitsi server configuration
# See JITSI_SETUP.md for instructions on setting up JWT
JITSI_APP_ID=your_jitsi_app_id
JITSI_APP_SECRET=your_jitsi_app_secret

# ============================================================================
# DEPRECATED - Privy Configuration (migrated to WaaP)
# ============================================================================
# NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here
# Keep commented - no longer needed with WaaP
